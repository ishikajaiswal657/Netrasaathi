# Git ignore file for Netrasaathi
# Never commit credentials, uploaded files, or environment builds.

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Secrets and environment files
.env
.env.local
.env.*.local
*.pem
*.key

# Uploaded documents and storage (privacy requirement)
backend/uploads/
uploads/

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
.npm
.eslintcache

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
