# ---------------------------------------------------------------------------
# Netrasaathi Environment Variables (Template)
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to Git!
# ---------------------------------------------------------------------------

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://netra_user:netra_password@localhost:5432/netrasaathi

# Security & JWT Token Settings
# Generate a strong key in production, for example: openssl rand -hex 32
SECRET_KEY=change_this_to_a_random_secret_key_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Vision & Reasoning (OpenAI API)
# Get your API key from https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here
MODEL_NAME=gpt-4o-mini

# File Upload Settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png

# OCR & Tesseract (Optional path if not in system PATH on Windows)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

